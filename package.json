{
    "name": "masala-web",
    "version": "1.0.0",
    "description": "This is the standalone marketing homepage for Ticket Masala.",
    "main": "src/main.js",
    "scripts": {
        "dev": "vite",
        "test": "vitest run",
        "build": "vite build && node scripts/postbuild.js",
        "preview": "vite preview",
        "lint": "eslint . --ext .js",
        "lint:fix": "eslint . --ext .js --fix",
        "format": "prettier --write \"src/**/*.{js,css,hbs}\"",
        "format:check": "prettier --check \"src/**/*.{js,css,hbs}\"",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Garamatic/masala-web.git"
    },
    "keywords": [
        "ticket-masala",
        "workflow",
        "ai",
        "multi-tenant"
    ],
    "author": "Garamatic",
    "license": "MIT",
    "type": "module",
    "bugs": {
        "url": "https://github.com/Garamatic/masala-web/issues"
    },
    "homepage": "https://github.com/Garamatic/masala-web#readme",
    "devDependencies": {
        "ajv": "^8.17.1",
        "autoprefixer": "^10.4.23",
        "eslint": "^8.57.0",
        "husky": "^9.1.7",
        "jsdom": "^27.4.0",
        "lint-staged": "^16.4.0",
        "postcss": "^8.4.35",
        "prettier": "^3.2.5",
        "tailwindcss": "^3.4.17",
        "vite": "^5.2.0",
        "vite-plugin-handlebars": "^2.0.0",
        "vitest": "^4.0.16"
    }
}
