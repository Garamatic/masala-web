<section
    class='min-h-screen flex items-center pt-20 relative overflow-hidden'
    aria-label='Hero Section'
>
    <div class='container mx-auto px-4 relative z-10 pt-20'>
        <div class='grid grid-cols-1 lg:grid-cols-12 gap-8 items-center'>
            <div class='lg:col-span-7 text-center lg:text-left mb-8 lg:mb-0 reveal'>
                <div
                    class='inline-flex items-center gap-2 px-3 py-2 rounded-sm glass-panel mb-4 interactive-glow'
                    role='alert'
                >
                    <span class='badge bg-success rounded-sm px-2'>
                        v3.0
                    </span>
                    <span class='text-sm text-secondary font-semibold'>
                        <span data-i18n='hero_intro'>
                            Announcing
                        </span>

                        <span class='text-primary'>
                            GERDA AI
                        </span>
                        <span data-i18n='hero_intro_2'>
                            Automated Workflows
                        </span>
                    </span>
                    <i class='fas fa-chevron-right text-xs text-muted ml-1' aria-hidden='true'></i>
                </div>

                <h1 class='text-5xl lg:text-7xl font-bold mb-6 leading-tight'>
                    <span data-i18n='hero_title_1'>
                        Ticket management
                    </span>

                    <br class='hidden lg:block' />
                    <span class='text-gradient-primary' data-i18n='hero_title_2'>
                        that actually works
                    </span>
                </h1>

                <p
                    class='text-xl text-secondary mb-8 lg:mb-12 mx-auto lg:mx-0 font-normal max-w-2xl'
                >
                    <span data-i18n='hero_desc_1'>
                        Open-source workflow orchestration with AI-powered triage, YAML-driven state
                        machines, and multi-tenant isolation. Deploy once, run every industry.
                    </span>
                </p>

                <div class='flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-8'>
                    <a
                        href='https://github.com/garamatic/ticket-masala'
                        class='btn btn-masala px-8 py-4 text-lg no-underline inline-flex items-center justify-center'
                        target='_blank'
                        rel='noopener'
                    >
                        <i class='fab fa-github mr-2' aria-hidden='true'></i>
                        Star on GitHub
                    </a>
                    <a
                        href='https://masala-doc.fly.dev'
                        class='btn btn-glass px-8 py-4 text-lg no-underline inline-flex items-center justify-center'
                        target='_blank'
                        rel='noopener'
                    >
                        <i class='fas fa-book mr-2' aria-hidden='true'></i>
                        <span data-i18n='nav_docs'>
                            Read the Docs
                        </span>
                    </a>
                </div>

                <div
                    class='mt-8 pt-4 flex flex-wrap gap-6 sm:gap-12 justify-center lg:justify-start opacity-75'
                >
                    <article class='text-center'>
                        <strong class='block text-2xl font-bold mb-0'>
                            100%
                        </strong>
                        <span class='text-sm text-muted' data-i18n='stat_opensource'>
                            Open Source
                        </span>
                    </article>
                    <article class='text-center'>
                        <strong class='block text-2xl font-bold mb-0'>
                            YAML
                        </strong>
                        <span class='text-sm text-muted' data-i18n='stat_config'>
                            Config-Driven
                        </span>
                    </article>
                    <article class='text-center'>
                        <strong class='block text-2xl font-bold mb-0'>
                            5
                        </strong>
                        <span class='text-sm text-muted' data-i18n='stat_themes'>
                            Theme Skins
                        </span>
                    </article>
                </div>
            </div>

            <div class='lg:col-span-5 relative reveal reveal-right'>
                <div class='relative' style='perspective: 2000px;'>
                    <figure
                        class='card-dossier p-0 overflow-hidden shadow-xl animate-float block m-0'
                        style='z-index: 2; transform: rotate3d(1, 1, 1, -5deg); border: 1px solid rgba(255,255,255,0.6);'
                    >
                        <figcaption
                            class='p-3 border-b border-structural flex items-center justify-between bg-surface backdrop-blur-sm'
                        >
                            <div class='flex gap-2'>
                                <span class='rounded-full w-2.5 h-2.5 bg-[#ff5f56]'></span>
                                <span class='rounded-full w-2.5 h-2.5 bg-[#ffbd2e]'></span>
                                <span class='rounded-full w-2.5 h-2.5 bg-[#27c93f]'></span>
                            </div>
                            <span class='text-xs font-mono opacity-50'>
                                workflow-config.yaml
                            </span>
                        </figcaption>

                        <div class='p-4 code-window text-left'>
                            <div class='mb-1'>
                                <span class='code-comment'>
                                    # Define your workflow logic
                                </span>
                            </div>
                            <div class='mb-1'>
                                <span class='code-keyword'>
                                    workflow:
                                </span>
                            </div>
                            <div class='mb-1 pl-4'>
                                <span class='code-attr'>
                                    - state:
                                </span>

                                <span class='code-string'>
                                    "New"
                                </span>
                            </div>
                            <div class='mb-1 pl-4'>
                                <span class='code-keyword'>
                                    transitions:
                                </span>
                            </div>
                            <div class='mb-1 pl-8'>
                                <span class='code-attr'>
                                    - to:
                                </span>

                                <span class='code-string'>
                                    "Triaged"
                                </span>
                            </div>
                            <div class='mb-1 pl-8'>
                                <span class='code-keyword'>
                                    rules:
                                </span>
                            </div>
                            <div class='mb-1 pl-12'>
                                <span class='code-attr'>
                                    - field:
                                </span>

                                <span class='code-string'>
                                    "priority"
                                </span>
                            </div>
                            <div class='mb-1 pl-12'>
                                <span class='code-attr'>
                                    op:
                                </span>

                                <span class='code-string'>
                                    "=="
                                </span>
                            </div>
                            <div class='mb-1 pl-12'>
                                <span class='code-attr'>
                                    value:
                                </span>

                                <span class='code-string'>
                                    "High"
                                </span>
                            </div>
                            <div
                                class='mt-4 text-accent text-sm border-t border-white border-opacity-10 pt-3 flex items-center'
                            >
                                <i class='fas fa-check-circle mr-1' aria-hidden='true'></i>
                                Rule Engine Active
                            </div>
                        </div>
                    </figure>

                    <div
                        class='absolute glass-panel rounded-sm p-3 flex flex-col gap-2 shadow-lg reveal'
                        style='bottom: -40px; right: -20px; z-index: 3; width: 180px;'
                    >
                        <span class='text-xs font-bold text-primary'>
                            System Processing
                        </span>
                        <div
                            class='h-1 bg-black/5 rounded-full overflow-hidden'
                            role='progressbar'
                            aria-valuenow='88'
                            aria-valuemin='0'
                            aria-valuemax='100'
                        >
                            <div class='h-full bg-success animate-pulse w-3/4'></div>
                        </div>
                        <div class='flex justify-between text-xs text-muted'>
                            <span>
                                Memory
                            </span>
                            <span>
                                88%
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>