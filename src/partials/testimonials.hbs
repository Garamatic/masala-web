<section
    class='py-20 lg:py-32 relative overflow-hidden'
    id='testimonials'
    aria-labelledby='testimonials-title'
>
    <div class='container mx-auto px-4'>
        <div class='text-center mb-16 reveal'>
            <h2 id='testimonials-title' class='text-4xl lg:text-5xl font-bold text-primary mb-4'>
                <span data-i18n='voices_title'>
                    From the
                </span>
                <span data-i18n='voices_title_2'>
                    Field
                </span>
            </h2>
            <p class='text-secondary text-xl mx-auto max-w-2xl' data-i18n='voices_subtitle'>
                How different industries use the same platform.
            </p>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto'>
            <!-- Desgoffe -->
            <figure class='reveal m-0'>
                <blockquote class='card-dossier h-full m-0 relative p-6'>
                    <div class='flex items-center gap-3 mb-4'>
                        <div
                            class='rounded-full bg-surface-elevated border border-structural flex items-center justify-center font-bold text-secondary shadow-sm w-10 h-10 text-sm'
                        >
                            BG
                        </div>
                        <figcaption>
                            <div
                                class='font-bold text-primary text-sm'
                                data-i18n='test_desgoffe_name'
                            >
                                Bourgmestre Gustave
                            </div>
                            <div class='text-xs text-muted' data-i18n='test_desgoffe_title'>
                                Ville de Desgoffe
                            </div>
                        </figcaption>
                    </div>
                    <p
                        class='text-secondary mb-0 text-sm leading-relaxed'
                        data-i18n='test_desgoffe_quote'
                    >
                        "The 'Stamp as Approved' workflow cut our citizen response time from three
                        days to four hours. The AI handles routing so my team focuses on actual
                        cases."
                    </p>
                </blockquote>
            </figure>

            <!-- Whitman -->
            <figure class='reveal m-0'>
                <blockquote class='card-dossier h-full m-0 relative p-6'>
                    <div class='flex items-center gap-3 mb-4'>
                        <div
                            class='rounded-full bg-warning text-black flex items-center justify-center font-bold shadow-sm w-10 h-10 text-sm'
                        >
                            JW
                        </div>
                        <figcaption>
                            <div
                                class='font-bold text-primary text-sm'
                                data-i18n='test_whitman_name'
                            >
                                Jack Whitman
                            </div>
                            <div class='text-xs text-muted' data-i18n='test_whitman_title'>
                                Whitman Spoor
                            </div>
                        </figcaption>
                    </div>
                    <p
                        class='text-secondary mb-0 text-sm leading-relaxed'
                        data-i18n='test_whitman_quote'
                    >
                        "I don't need fancy menus. I need big buttons and a map. This system gets me
                        to the broken track fast, and the AI scores severity before I even open the
                        ticket."
                    </p>
                </blockquote>
            </figure>

            <!-- Liberty -->
            <figure class='reveal m-0'>
                <blockquote class='card-dossier h-full m-0 relative p-6'>
                    <div class='flex items-center gap-3 mb-4'>
                        <div
                            class='rounded-full bg-success text-white flex items-center justify-center font-bold shadow-sm w-10 h-10 text-sm'
                        >
                            AC
                        </div>
                        <figcaption>
                            <div
                                class='font-bold text-primary text-sm'
                                data-i18n='test_liberty_name'
                            >
                                Alex Chen
                            </div>
                            <div class='text-xs text-muted' data-i18n='test_liberty_title'>
                                Liberty Systems
                            </div>
                        </figcaption>
                    </div>
                    <p
                        class='text-secondary mb-0 text-sm leading-relaxed'
                        data-i18n='test_liberty_quote'
                    >
                        "Deployed the whole stack in Docker Compose. Four tenants running in under
                        an hour. The YAML config means our devops team ships workflow changes
                        without touching code."
                    </p>
                </blockquote>
            </figure>

            <!-- Hennessey -->
            <figure class='reveal m-0'>
                <blockquote class='card-dossier h-full m-0 relative p-6'>
                    <div class='flex items-center gap-3 mb-4'>
                        <div
                            class='rounded-full bg-info text-black flex items-center justify-center font-bold shadow-sm w-10 h-10 text-sm'
                        >
                            EO
                        </div>
                        <figcaption>
                            <div
                                class='font-bold text-primary text-sm'
                                data-i18n='test_hennessey_name'
                            >
                                Eleanor Oseary
                            </div>
                            <div class='text-xs text-muted' data-i18n='test_hennessey_title'>
                                Fonds Hennessey
                            </div>
                        </figcaption>
                    </div>
                    <p
                        class='text-secondary mb-0 text-sm leading-relaxed'
                        data-i18n='test_hennessey_quote'
                    >
                        "Grant compliance used to take my team a full day per application. The AI
                        compliance checker catches issues at submission, not review. We process
                        twice the volume now."
                    </p>
                </blockquote>
            </figure>
        </div>
    </div>
</section>