<section
    class='py-20 lg:py-32 relative overflow-hidden'
    id='testimonials'
    aria-labelledby='testimonials-title'
>
    <div class='container mx-auto px-4'>
        <div class='text-center mb-16 reveal'>
            <h2 id='testimonials-title' class='text-4xl lg:text-5xl font-bold text-primary mb-4'>
                <span data-i18n='voices_title'>
                    Voices of the
                </span>
                <span class='text-gradient-primary' data-i18n='voices_title_2'>
                    Ecosystem
                </span>
            </h2>
            <p class='text-secondary text-xl mx-auto max-w-2xl' data-i18n='voices_subtitle'>
                Trusted by leaders across every dimension.
            </p>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8'>
            <!-- Desgoffe -->
            <figure class='reveal reveal-left m-0'>
                <blockquote
                    class='card-dossier testimonial-card desgoffe h-full interactive-lift m-0 relative'
                >
                    <div class='flex items-center gap-3 mb-4'>
                        <div
                            class='rounded-full bg-surface-elevated border border-structural flex items-center justify-center font-bold text-secondary shadow-sm w-12 h-12'
                            style="font-family: 'Archer', serif;"
                        >
                            BG
                        </div>
                        <figcaption>
                            <div class='font-bold text-primary' data-i18n='test_desgoffe_name'>
                                Bourgmestre Gustave
                            </div>
                            <div class='text-sm text-muted' data-i18n='test_desgoffe_title'>
                                Ville de Desgoffe
                            </div>
                        </figcaption>
                    </div>
                    <p class='text-secondary mb-0 italic' data-i18n='test_desgoffe_quote'>
                        "Finally, a system that respects proper protocol. The 'Stamp as Approved'
                        workflow is simply exquisite."
                    </p>
                </blockquote>
            </figure>

            <!-- Whitman -->
            <figure class='reveal delay-100 m-0'>
                <blockquote
                    class='card-dossier testimonial-card whitman h-full interactive-lift m-0 relative'
                >
                    <div class='flex items-center gap-3 mb-4'>
                        <div
                            class='rounded-full bg-warning text-black flex items-center justify-center font-bold shadow-sm w-12 h-12'
                            style="font-family: 'Oswald', sans-serif;"
                        >
                            JW
                        </div>
                        <figcaption>
                            <div class='font-bold text-primary' data-i18n='test_whitman_name'>
                                Jack Whitman
                            </div>
                            <div class='text-sm text-muted' data-i18n='test_whitman_title'>
                                Whitman Spoor
                            </div>
                        </figcaption>
                    </div>
                    <p class='text-secondary mb-0 italic' data-i18n='test_whitman_quote'>
                        "I don't need fancy menus. I need big buttons and a map. This system gets me
                        to the broken track fast."
                    </p>
                </blockquote>
            </figure>

            <!-- Liberty (NEW) -->
            <figure class='reveal delay-200 m-0'>
                <blockquote
                    class='card-dossier testimonial-card liberty h-full interactive-lift m-0 relative'
                >
                    <div class='flex items-center gap-3 mb-4'>
                        <div
                            class='rounded-full bg-success text-white flex items-center justify-center font-bold shadow-sm w-12 h-12'
                            style="font-family: 'JetBrains Mono', monospace;"
                        >
                            AC
                        </div>
                        <figcaption>
                            <div class='font-bold text-primary' data-i18n='test_liberty_name'>
                                Alex Chen
                            </div>
                            <div class='text-sm text-muted' data-i18n='test_liberty_title'>
                                Liberty Systems
                            </div>
                        </figcaption>
                    </div>
                    <p class='text-secondary mb-0 italic' data-i18n='test_liberty_quote'>
                        "The dark mode interface is perfect for our 3 AM deploys. GERDA AI predicts
                        incidents before they happen."
                    </p>
                </blockquote>
            </figure>

            <!-- Hennessey -->
            <figure class='reveal reveal-right delay-300 m-0'>
                <blockquote
                    class='card-dossier testimonial-card hennessey h-full interactive-lift m-0 relative'
                >
                    <div class='flex items-center gap-3 mb-4'>
                        <div
                            class='rounded-full bg-info text-black flex items-center justify-center font-bold shadow-sm w-12 h-12'
                            style="font-family: 'Garamond', serif;"
                        >
                            EO
                        </div>
                        <figcaption>
                            <div class='font-bold text-primary' data-i18n='test_hennessey_name'>
                                Eleanor Oseary
                            </div>
                            <div class='text-sm text-muted' data-i18n='test_hennessey_title'>
                                Fonds Hennessey
                            </div>
                        </figcaption>
                    </div>
                    <p class='text-secondary mb-0 italic' data-i18n='test_hennessey_quote'>
                        "Managing grants requires precision. The AI compliance checker saves my team
                        hours every single day."
                    </p>
                </blockquote>
            </figure>
        </div>
    </div>
</section>
